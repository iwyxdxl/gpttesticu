{
  "name": "gpttest-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/assets','dist/assets',{recursive:true})\"",
    "start": "node dist/index.js",
    "test": "node --import tsx --test ../scripts/core.test.mts ../scripts/visitors.test.mts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "css-tree": "^3.2.1",
    "hono": "^4.6.14",
    "isomorphic-dompurify": "^3.19.0"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
